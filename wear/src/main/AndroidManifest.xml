<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Required for IMU access (Accelerometer, Gyroscope) -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required to display the "Recording stroke data" foreground service notification on API 33+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required to start a foreground service of type dataSync on API 34+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             dataSync fits what this service actually does: stream captured IMU samples to the
             phone over the Wearable Data Layer. It previously declared foregroundServiceType
             "health", but that type requires the BODY_SENSORS permission (accelerometer/gyroscope
             do not) and this service performs no heart-rate/health-sensor reads, so "health" was
             both inaccurate and would have forced back a permission tied to a feature that isn't
             implemented (see the removed heart-rate scaffolding below).
        -->
        <service
            android:name=".service.SensorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.WearableMessageService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/trainer" />
            </intent-filter>
        </service>

    </application>

</manifest>
