# Cue d'État — ignore rules.
#
# This file was 2,947 lines and 290 KB. Almost all of it was one enumerated path
# per generated file: thousands of /opencv/java/javadoc/*.html entries from a
# vendored SDK that is no longer in the repository, per-session Kotlin compiler
# .salive files, and one line for every timestamped context dump an agent had
# ever dropped in the working tree. Patterns, not an inventory.

# ── Gradle / build output ────────────────────────────────────────────────────
.gradle/
build/
*/build/
**/build/
!src/**/build/
captures/
.externalNativeBuild/
.cxx/
*.log

# ── Local configuration & secrets ────────────────────────────────────────────
local.properties
*.jks
*.keystore
!debug.keystore
google-services.json
secrets.properties

# ── Kotlin ───────────────────────────────────────────────────────────────────
.kotlin/

# ── IDE ──────────────────────────────────────────────────────────────────────
*.iml
.idea/
!.idea/codeStyles/
!.idea/inspectionProfiles/
.vscode/
*.swp
*~

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Node (docs tooling) ──────────────────────────────────────────────────────
node_modules/

# ── Agent scratch ────────────────────────────────────────────────────────────
# Timestamped context/backup dumps. These used to be listed one line at a time,
# which is why this file grew by a line per session.
project_context_for_ai_*
project_backup_full_*
project_source_only_*
project_source_scoped_*
.superpowers/
